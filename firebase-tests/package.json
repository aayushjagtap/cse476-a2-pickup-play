{
  "name": "pickupplay-firestore-rules-tests",
  "private": true,
  "description": "Runs firestore.rules in the official Firestore emulator and checks who may read and write.",
  "type": "module",
  "scripts": {
    "test": "node --test rules.test.mjs",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-pickupplay \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0"
  }
}
