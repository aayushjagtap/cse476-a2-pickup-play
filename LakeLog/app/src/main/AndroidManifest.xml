<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The light sensor is optional: the app says so when a device has none. -->
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LakeLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReadingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="@string/title_readings" />

        <activity
            android:name=".NoteActivity"
            android:exported="false"
            android:parentActivityName=".ReadingsActivity"
            android:label="@string/title_note" />

    </application>
</manifest>
