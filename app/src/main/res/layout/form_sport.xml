<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/FormSectionLabel"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/form_section_sport" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sport_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_basketball"
            style="@style/FormChip"
            android:text="@string/sport_basketball" />
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_soccer"
            style="@style/FormChip"
            android:text="@string/sport_soccer" />
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_volleyball"
            style="@style/FormChip"
            android:text="@string/sport_volleyball" />
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_tennis"
            style="@style/FormChip"
            android:text="@string/sport_tennis" />
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_ultimate"
            style="@style/FormChip"
            android:text="@string/sport_ultimate" />
        <com.google.android.material.chip.Chip
            android:id="@id/chip_sport_pickleball"
            style="@style/FormChip"
            android:text="@string/sport_pickleball" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
